<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.jerome-group.ntulearn.watchdog</string>
	<key>ProgramArguments</key>
	<array>
		<string>/absolute/path/to/node</string>
		<string>/absolute/path/to/ntulearn/src/cli.mjs</string>
		<string>watchdog</string>
	</array>
	<key>WorkingDirectory</key>
	<string>/absolute/path/to/ntulearn</string>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>5</integer>
		<key>Minute</key>
		<integer>0</integer>
	</dict>
	<key>StandardOutPath</key>
	<string>/absolute/path/to/ntulearn/.data/launchd-watchdog.stdout.log</string>
	<key>StandardErrorPath</key>
	<string>/absolute/path/to/ntulearn/.data/launchd-watchdog.stderr.log</string>
</dict>
</plist>
