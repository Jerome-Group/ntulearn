# macOS
.DS_Store

# Editors
.vscode/
.idea/
*.swp

# Env / secrets
.env
.env.*
*.local

# Dependencies
node_modules/

# The saved NTU session and the sync state. `.data/chrome-profile` is a live authenticated
# browser profile — this repository's actual secret — and it is permission-restricted on disk.
# It has never been tracked, which is the only state from which that is free.
.data/

# The local module configuration: a personal Drive destination path and real course identifiers.
# Ignored rather than tracked, so it never enters the history of a public repository. See
# `README.md` for the shape it should have.
config/courses.json
# And a copy of it under any suffix: a backup is what somebody makes just before editing
# the file this rule protects, so it exists exactly when the identifiers are in play.
config/courses.json.*

# A destination this repository owns, for a prototype that must not write into a real one. It is
# the one folder `docs/adr/0003`'s reopening trigger names — created here, written by nothing else,
# and holding a course somebody is trying an idea against rather than a copy anybody keeps.
.scratch/

# Partial downloads
*.part-*
